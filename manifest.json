{
  "manifest_version": 3,
  "name": "Browser Cowork",
  "version": "0.2.0",
  "description": "An AI agent in Chrome's side panel that can read and operate the tab you are on.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "scripting",
    "tabs",
    "storage",
    "debugger"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Browser Cowork"
  }
}
