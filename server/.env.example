# Copy to .env and fill in. Only the key for the provider you use is required.

# deepseek | gemini | openai
PROVIDER=deepseek

# --- DeepSeek (default) -----------------------------------------------------
# Model ids: deepseek-flash (DeepSeek-V4.1-Flash, text + image)
#            deepseek-v4-pro (text only)
# The older deepseek-chat / deepseek-reasoner names are gone.
DEEPSEEK_API_KEY=
MODEL=deepseek-flash

# Thinking mode is off by default. Enable it only if you want the model to
# reason before each action; it adds latency to every step.
THINKING=disabled
# REASONING_EFFORT=low

# --- Gemini -----------------------------------------------------------------
# PROVIDER=gemini
# GEMINI_API_KEY=
# MODEL=gemini-2.5-flash

# --- OpenAI-compatible (OpenAI, OpenRouter, Groq, Ollama, LM Studio…) --------
# PROVIDER=openai
# OPENAI_API_KEY=
# BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4.1-mini

# --- Server -----------------------------------------------------------------
PORT=8787
# Generated automatically into server/.token when unset. Paste it into the panel.
# COPILOT_TOKEN=
# Pin the extension origin once Chrome has assigned it (recommended):
# ALLOW_ORIGIN=chrome-extension://abcdefghijklmnopabcdefghijklmnop
